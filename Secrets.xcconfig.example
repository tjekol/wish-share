// Copy this file to Secrets.xcconfig (same folder) and fill in your own
// Supabase project values. Secrets.xcconfig is gitignored and must never
// be committed.

// xcconfig treats "//" as a comment, so URLs need the empty macro "$()"
// to break up the slashes.
SUPABASE_URL = https:/$()/YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY = YOUR_ANON_PUBLIC_KEY

// Exposes the values above into the generated Info.plist.
INFOPLIST_KEY_SUPABASE_URL = $(SUPABASE_URL)
INFOPLIST_KEY_SUPABASE_ANON_KEY = $(SUPABASE_ANON_KEY)
